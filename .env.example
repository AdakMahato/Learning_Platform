# Authentication & Session Isolation Mode:
#   local     - Single local developer workspace (+ optional Account sign-in)
#   multiuser - Public multi-user deployments: per-session guest isolation + accounts
#   required  - Private/enterprise deployments: mandatory sign-in gate
PLATFORM_AUTH_MODE=multiuser

# Secret key for HMAC-SHA256 session cookies/tokens (generate with: openssl rand -hex 32)
PLATFORM_SECRET_KEY=replace-with-a-64-char-random-hex-secret

# SQLite WAL database location
PLATFORM_DB_PATH=./data/platform.db

# Max concurrent sandboxed code/SQL/judge subprocesses across all users
RUNNER_MAX_CONCURRENCY=4
